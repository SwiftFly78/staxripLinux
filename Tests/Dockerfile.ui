# The ui suite: Arch Linux with the newest GTK, openbox, sway, KWin and GNOME Shell. Its packages are the ones of the
# day the base image was built, from the Arch Linux Archive, so the image only changes with the digest. sway and KWin
# can't start in a container with their capabilities, the suite adds its user to /etc/passwd for D-Bus and KWin, GNOME
# Shell needs a machine ID. gcc builds the input client of the suite, Pillow writes the bitmap subtitles of the OCR
# test, tesseract-data-eng has their language. The archive stalls now and then, pacman gives up on such a download
# after 10 seconds and is tried again, with the packages it already has in its cache.
FROM archlinux:base@sha256:d4594bb2300cba11f41c2f27923eb56f63d9988909c402f9c95517d1e362c899
ENV LANG=C.UTF-8
RUN day=$(date -d "$(LC_ALL=C pacman -Qi pacman | sed -n 's/^Install Date *: //p')" +%Y/%m/%d) \
    && echo "Server = https://archive.archlinux.org/repos/$day/\$repo/os/\$arch" > /etc/pacman.d/mirrorlist \
    && for attempt in 1 2 3 4 5; do \
        pacman -Syu --noconfirm --needed gtk3 icu ttf-dejavu dbus jq xorg-server-xvfb xdotool xclip openbox sway \
            wtype wl-clipboard grim kwin gnome-shell gcc wlr-protocols plasma-wayland-protocols python-pillow \
            tesseract-data-eng && break; \
        [ $attempt = 5 ] && exit 1; \
        sleep 20; \
    done \
    && rm -rf /var/cache/pacman/pkg/* \
    && setcap -r /usr/bin/sway && setcap -r /usr/bin/kwin_wayland \
    && dbus-uuidgen --ensure=/etc/machine-id \
    && chmod 666 /etc/passwd
