<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>StaxRip</AssemblyName>
    <RootNamespace>StaxRip</RootNamespace>
    <StartupObject>StaxRip.Startup</StartupObject>
    <MyType>Empty</MyType>
    <DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
    <OptionCompare>Binary</OptionCompare>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <WarningLevel>1</WarningLevel>
    <NoWarn>$(NoWarn);41998;42004;42025;42026;42029;42030;42031;42104;42105;42106;42107;42108;42109;42353;42354;42355;SYSLIB0011;SYSLIB0050;SYSLIB0051;CA1416</NoWarn>
    <WarningsAsErrors>41999;42016;42017;42018;42019;42020;42021;42022;42024;42032;42036;42099</WarningsAsErrors>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.IO" />
    <Import Include="System.Linq" />
    <Import Include="Eto.Forms" />
    <Import Include="Eto.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Eto.Forms" Version="2.12.0" />
    <PackageReference Include="Eto.Platform.Gtk" Version="2.12.0" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.12" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.6" />
    <!-- the PowerShell SDK references versions with known vulnerabilities -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\**" />
    <Compile Remove="FrameServer\**" />
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="**\*.resx" />
    <None Remove="**\*.resx" />
    <None Remove="Tools\**" />
    <None Remove="FrameServer\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\StaxRip.png" LogicalName="StaxRip.png" />
    <EmbeddedResource Include="Video\AviSynthFilterProfileDefaults.txt" LogicalName="StaxRip.AviSynthFilterProfileDefaults.txt" />
    <EmbeddedResource Include="Video\VapourSynthFilterProfileDefaults.txt" LogicalName="StaxRip.VapourSynthFilterProfileDefaults.txt" />
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="StaxRip.CHANGELOG.md" Link="CHANGELOG.md" />
    <EmbeddedResource Include="..\CHANGELOG-SUPPORTER.md" LogicalName="StaxRip.CHANGELOG-SUPPORTER.md" Link="CHANGELOG-SUPPORTER.md" />
    <None Include="..\License.txt" Link="License.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
