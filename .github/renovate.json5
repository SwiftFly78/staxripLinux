// Recommends the updates of the bundled tools, the NuGet packages, the actions and the images in one pull request,
// which the tests of CI check before a merge. Runs in .github/workflows/renovate.yml, see "Updates" in the README of
// Bundle.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':semanticCommits'],
  // broken and malicious releases are usually found within two weeks
  minimumReleaseAge: '14 days',
  // new branches on Fridays at noon, when the workflow starts Renovate, the hour after covers delayed and long runs,
  // updates ticked in the Dependency Dashboard get their branch at once
  timezone: 'Europe/Berlin',
  schedule: ['* 12-13 * * 5'],
  separateMajorMinor: false,
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  labels: ['dependencies'],
  customManagers: [
    {
      // the annotated versions of the recipes and of the tools of the AppImage, Bundle/renovate.py completes the updates
      customType: 'regex',
      managerFilePatterns: ['/^Bundle/components/[^/]+\\.sh$/', '/^Source/appimage-tools\\.sh$/'],
      matchStrings: [
        '[a-z0-9_]*version=(?<currentValue>\\S+) # renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?(?: (?:source|tag|urlversion|special)=\\S+)*\\n',
        '[a-z0-9_]*version=\\S+ # renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+) digest=(?<currentDigest>[0-9a-f]{40})(?: source=\\S+)?\\n',
      ],
    },
    {
      // Renovate only reads the hashes of requirements files in the style of pip-compile
      customType: 'regex',
      managerFilePatterns: ['/^Bundle/requirements-build\\.txt$/'],
      matchStrings: ['(?<depName>[A-Za-z0-9._-]+)==(?<currentValue>\\S+) --hash=sha256:[0-9a-f]{64}'],
      datasourceTemplate: 'pypi',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/renovate\\.yml$/'],
      matchStrings: ['RENOVATE_VERSION: (?<currentValue>\\S+) # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)'],
    },
  ],
  packageRules: [
    {
      matchFileNames: ['Bundle/components/**'],
      semanticCommitType: 'build',
      semanticCommitScope: 'bundle',
      commitMessageTopic: "{{depName}} of {{{replace '^Bundle/components/(.+)\\.sh$' '$1' packageFile}}}",
      addLabels: ['bundle'],
      postUpgradeTasks: {
        commands: ['python3 Bundle/renovate.py post-upgrade {{{packageFile}}}'],
        fileFilters: ['Bundle/components/**'],
        executionMode: 'update',
      },
    },
    {
      matchFileNames: ['Source/appimage-tools.sh'],
      semanticCommitType: 'build',
      semanticCommitScope: 'appimage',
      postUpgradeTasks: {
        commands: ['python3 Bundle/renovate.py post-upgrade {{{packageFile}}}'],
        fileFilters: ['Source/appimage-tools.sh'],
        executionMode: 'update',
      },
    },
    {
      // git branches have no release dates
      matchDatasources: ['git-refs'],
      minimumReleaseAge: null,
    },
    {
      // a new build image rebuilds every bundled tool
      matchFileNames: ['Bundle/Dockerfile', 'Bundle/requirements-build.txt'],
      semanticCommitType: 'build',
      semanticCommitScope: 'bundle',
      postUpgradeTasks: {
        commands: ['python3 Bundle/renovate.py post-upgrade {{{packageFile}}}'],
        fileFilters: ['Bundle/requirements-build.txt'],
        executionMode: 'update',
      },
    },
    {
      matchManagers: ['pip_requirements'],
      enabled: false,
    },
    {
      matchFileNames: ['Tests/Dockerfile', 'Tests/Dockerfile.gpu'],
      semanticCommitType: 'test',
    },
    {
      // the Ubuntu releases are chosen: the bundle is built on 22.04 for the glibc of the oldest supported systems,
      // the tests run there too, the frames suite on 24.04, whose PoCL runs NNEDI3CL, only their digests are updated
      matchDatasources: ['docker'],
      matchPackageNames: ['ubuntu'],
      matchUpdateTypes: ['major', 'minor'],
      enabled: false,
    },
    {
      matchManagers: ['nuget'],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'ci',
    },
    {
      // its tag 1.5.8 is from 2012, older than 1.3.0
      matchDepNames: ['Asd-g/MPEG2DecPlus'],
      allowedVersions: '!/^1\\.5\\.8$/',
    },
    {
      // all updates in one pull request, a group takes most settings from its first update, so its schedule and scope
      // are the same for all
      matchPackageNames: ['*'],
      groupName: 'all dependencies',
      groupSlug: 'all',
      semanticCommitScope: 'deps',
    },
    {
      // known breaks, recommended in the Dependency Dashboard, a pull request of their own only after their approval
      // there, in the group every update would wait for it
      matchDepNames: ['FFmpeg/FFmpeg'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      groupName: null,
      semanticCommitScope: 'bundle',
      prBodyNotes: ['L-SMASH-Works needs the API of FFmpeg 8, check whether it builds with the new major version.'],
    },
    {
      matchDepNames: ['VapourSynth'],
      dependencyDashboardApproval: true,
      groupName: null,
      semanticCommitScope: 'bundle',
      prBodyNotes: ['VapourSynth R80 and newer don\'t load the API 3 plugins of the bundle, check the plugin load test.'],
    },
    {
      matchDepNames: ['videolan/libplacebo'],
      matchUpdateTypes: ['major', 'minor'],
      dependencyDashboardApproval: true,
      groupName: null,
      semanticCommitScope: 'bundle',
      prBodyNotes: ['QSVEncC and VCEEncC need the API layout of libplacebo 7.360.'],
    },
    {
      matchDepNames: ['vapoursynth/bestsource'],
      dependencyDashboardApproval: true,
      groupName: null,
      semanticCommitScope: 'bundle',
      prBodyNotes: ['BestSource R22 and newer use VapourSynth API functions R79 lacks, check the plugin load test.'],
    },
    {
      // the minimum drivers are in the README of nv-codec-headers (12: 550.54, 13: 570), CI has no NVIDIA GPU
      matchDepNames: ['FFmpeg/nv-codec-headers'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      groupName: null,
      semanticCommitScope: 'bundle',
      prBodyNotes: ['A major version raises the minimum NVIDIA driver of NVENC, NVDEC and CUDA in FFmpeg.'],
    },
  ],
}
